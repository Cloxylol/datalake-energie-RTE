CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.http.staticuser.user=hadoop
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# Chemins de stockage declares EXPLICITEMENT. Par defaut Hadoop les derive de
# l'utilisateur courant (file:///tmp/hadoop-${user.name}/dfs/...) : l'image
# apache/hadoop:3.3.6 tourne en `hadoop`, donc le namenode cherchait
# /tmp/hadoop-hadoop/dfs/name pendant que docker-compose.yml montait ses
# volumes sur /tmp/hadoop-root/dfs/... — le namenode sortait en code 1 sur un
# InconsistentFSStateException, et le volume nomme ne servait a rien.
HDFS-SITE.XML_dfs.namenode.name.dir=file:///tmp/hadoop-root/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///tmp/hadoop-root/dfs/data
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.permissions.enabled=false
