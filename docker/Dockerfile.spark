# Image Spark du projet.
#
# L'image Bitnami nue n'embarque aucune dependance Python applicative. Or tous
# les jobs Spark du depot passent par common/config.py, qui importe `yaml` des
# la premiere ligne utile : sans PyYAML, silver_grid, silver_weather et
# gold_build echouent tous sur ModuleNotFoundError avant meme d'ouvrir une
# SparkSession. Le driver tourne dans spark-master et les executeurs dans
# spark-worker, d'ou une seule image pour les deux services.
#
# bitnamilegacy/ et non bitnami/ : Docker Hub a purge les anciens tags Bitnami
# en aout 2025. Meme lignee d'image, donc SPARK_MODE et les autres variables
# du docker-compose.yml restent valides.
FROM bitnamilegacy/spark:3.5.1

USER root

# Versions alignees sur requirements.txt : l'environnement du cluster ne doit
# pas diverger de celui dans lequel les jobs sont ecrits et testes.
#   PyYAML   conf/sources.yml et conf/silver_mapping.yml
#   requests jours feries de gold_build (echec non bloquant, mais present)
RUN install_packages python3-pip 2>/dev/null || true; \
    pip install --no-cache-dir --break-system-packages \
        PyYAML==6.0.2 requests==2.32.3 \
    || pip install --no-cache-dir PyYAML==6.0.2 requests==2.32.3

USER 1001
